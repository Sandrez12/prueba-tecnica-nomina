@using Nomina.Web.Auth
@{
    ViewData["Title"] = "Inicio";
}
<h1 class="h3">Sesión iniciada</h1>
<p>Conectado como <strong>@User.Identity?.Name</strong>.</p>
@if (User.IsInRole(Roles.Admin))
{
    <a asp-controller="People" asp-action="Index" class="btn btn-primary mb-3">Gestionar personas</a>
}
<form asp-action="Logout" method="post">
    <button type="submit" class="btn btn-outline-secondary btn-lg">Cerrar sesión</button>
</form>
