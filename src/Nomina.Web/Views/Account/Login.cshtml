@model Nomina.Web.Controllers.LoginInput
@{
    ViewData["Title"] = "Iniciar sesión";
}
<div class="login-shell">
        <div class="login-landscape" aria-hidden="true">
            <img src="~/images/chicamocha.svg" alt="" width="760" height="480">
            <div class="landscape-caption">
                <strong>Nómina Chicamocha</strong>
                <span>Del registro diario al cierre del mes.</span>
            </div>
        </div>
        <section class="login-panel">
            <h1>Iniciar sesión</h1>
            <p class="text-body-secondary">Usa la cuenta que te asignó administración.</p>
            <form asp-action="Login" method="post">
                <div asp-validation-summary="All" class="text-danger" aria-live="polite"></div>
                <div class="mb-3">
                    <label asp-for="UserName" class="form-label">Usuario</label>
                    <input asp-for="UserName" class="form-control form-control-lg" autocomplete="username" required>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Contraseña</label>
                    <input id="Password" name="Password" type="password" class="form-control form-control-lg"
                           autocomplete="current-password" required>
                </div>
                <button class="btn btn-primary btn-lg w-100" type="submit">Ingresar</button>
            </form>
        </section>
</div>
