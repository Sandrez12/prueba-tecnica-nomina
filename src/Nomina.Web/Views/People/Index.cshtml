@model IReadOnlyList<Nomina.Web.Controllers.PersonRow>
@{
    ViewData["Title"] = "Personas";
}
<a asp-controller="Account" asp-action="Home" class="d-inline-block mb-3">Volver al inicio</a>
<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Personas</h1>
    <a asp-action="Create" class="btn btn-primary">Nueva persona</a>
</div>
@if (TempData["PeopleMessage"] is string message)
{
    <p class="alert alert-success" role="status">@message</p>
}
@if (Model.Count == 0)
{
    <p class="empty-state">Aún no hay personas registradas. Usa «Nueva persona» para agregar la primera.</p>
}
else
{
    <div class="table-responsive data-panel" tabindex="0" role="region" aria-label="Listado de personas">
        <table class="table table-striped align-middle">
            <thead><tr><th scope="col">Nombre</th><th scope="col">Documento</th><th scope="col">Usuario</th><th scope="col">Estado</th><th scope="col">Acciones</th></tr></thead>
            <tbody>
            @foreach (var person in Model)
            {
                <tr><td>@person.FirstName @person.LastName</td><td>@person.Document</td><td>@person.UserName</td>
                    <td><span class="status-label @(person.IsActive ? "status-closed" : "status-neutral")">@(person.IsActive ? "Activa" : "Inactiva")</span></td>
                    <td>
                        @if (!person.IsAdmin)
                        {
                            <a asp-action="Edit" asp-route-id="@person.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Contacts" asp-route-id="@person.Id" class="btn btn-sm btn-outline-secondary">Contactos</a>
                            <a asp-action="Delete" asp-route-id="@person.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        }
                        else { <span>Cuenta protegida</span> }
                    </td></tr>
            }
            </tbody>
        </table>
    </div>
}
