@model IReadOnlyList<Nomina.Web.Controllers.PersonRow>
@{
    ViewData["Title"] = "Personas";
}
<a asp-controller="Account" asp-action="Home" class="d-inline-block mb-3">Volver al inicio</a>
<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Personas</h1>
    <a asp-action="Create" class="btn btn-primary">Nueva persona</a>
</div>
@if (TempData["PeopleMessage"] is string message)
{
    <p class="alert alert-success" role="status">@message</p>
}
@if (Model.Count == 0)
{
    <p>Aún no hay personas registradas.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead><tr><th scope="col">Nombre</th><th scope="col">Documento</th><th scope="col">Usuario</th><th scope="col">Estado</th></tr></thead>
            <tbody>
            @foreach (var person in Model)
            {
                <tr><td>@person.FirstName @person.LastName</td><td>@person.Document</td><td>@person.UserName</td>
                    <td>@(person.IsActive ? "Activa" : "Inactiva")</td></tr>
            }
            </tbody>
        </table>
    </div>
}
