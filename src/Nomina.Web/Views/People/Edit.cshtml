@model Nomina.Web.Controllers.PersonInput
@using Nomina.Web.Auth
@{
    ViewData["Title"] = "Editar persona";
}
<div class="mx-auto" style="max-width: 46rem">
    <a asp-action="Index" class="d-inline-block mb-3">Volver a personas</a>
    <h1 class="h3">Editar persona</h1>
    <p>Los cambios en esta ficha no modifican los datos guardados en la nómina cerrada.</p>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="bg-body border rounded-3 p-3 p-md-4">
        <div asp-validation-summary="All" class="text-danger" aria-live="polite"></div>
        <div class="row g-3 mb-4">
            <div class="col-sm-6"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control" required></div>
            <div class="col-sm-6"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control" required></div>
            <div class="col-sm-6"><label asp-for="Document" class="form-label"></label><input asp-for="Document" class="form-control" required></div>
            <div class="col-sm-6"><label asp-for="MonthlySalary" class="form-label"></label><input asp-for="MonthlySalary" class="form-control" type="number" min="0" max="999999999" step="1" required></div>
            <div class="col-sm-7"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control" required></div>
            <div class="col-sm-5"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" type="tel" required></div>
            <div class="col-sm-6"><label asp-for="UserName" class="form-label"></label><input asp-for="UserName" class="form-control" required></div>
            <div class="col-sm-6">
                <label asp-for="Role" class="form-label"></label>
                <select asp-for="Role" class="form-select">
                    <option value="@Roles.Worker">Trabajador</option>
                    <option value="@Roles.Lead">Jefatura</option>
                    <option value="@Roles.Accountant">Contabilidad</option>
                </select>
            </div>
            <div class="col-12">
                <div class="form-check"><input asp-for="IsActive" class="form-check-input"><label asp-for="IsActive" class="form-check-label"></label></div>
            </div>
        </div>
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
    </form>
</div>
